---
layout: layouts/page.njk
title: Contact
permalink: /contact/
ogImage: /img/hero/contact-hero.jpg
---
<div class="hero--photo">
  <img class="hero__bg" src="/img/hero/contact-hero.jpg" alt="" width="2000" height="1211">
  <div class="hero__content wrapper">
    <h1>Contact</h1>
  </div>
</div>

<dl class="contact-details wrapper">
  {% if business.phone %}
  <dt>Phone</dt>
  <dd><a href="tel:{{ business.phone }}">{{ business.phone }}</a></dd>
  {% endif %}
  {% if business.fax %}
  <dt>Fax</dt>
  <dd>{{ business.fax }}</dd>
  {% endif %}
  {% if business.email %}
  <dt>Email</dt>
  <dd><a href="mailto:{{ business.email }}">{{ business.email }}</a></dd>
  {% endif %}
  {% if business.address %}
  <dt>Address</dt>
  <dd>
    {{ business.address }}<br>
    <a class="btn btn--primary" href="https://www.google.com/maps/search/?api=1&amp;query={{ business.address | urlencode }}" target="_blank" rel="noopener">Get directions</a>
  </dd>
  {% endif %}
</dl>

