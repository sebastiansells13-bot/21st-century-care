---
layout: layouts/page.njk
title: Services
permalink: /services/
ogImage: /img/hero/services-hero.jpg
---
<div class="hero--photo">
  <img class="hero__bg" src="/img/hero/services-hero.jpg" alt="" width="2000" height="1500">
  <div class="hero__content wrapper">
    <h1 data-i18n="nav.services">Services</h1>
    <p data-i18n="overview.ccssPss">
      Comprehensive Community Support Services (CCSS) and Peer Support Services (PSS)
      are available to Medicaid recipients. Services help clients develop skills and
      connect to resources related to independent and community living, learning,
      employment, socialization, and recreation.
    </p>
  </div>
</div>

{% for category, items in services.list | groupby("category") %}
<div class="category-section {{ loop.index0 | tintClass }}">
  <div class="wrapper">
    {% if category %}<h2>{{ category }}</h2>{% endif %}
    <div class="services-grid">
      {% for service in items %}
      <div class="service-card">
        {% if service.icon %}
          <img src="{{ service.icon }}" alt="" class="service-card__icon">
        {% else %}
          <span class="service-card__badge">{{ service.title | serviceIcon }}</span>
        {% endif %}
        <h3>{{ service.title }}</h3>
        <p>{{ service.description | safe }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endfor %}

{% include "components/crisis-callout.njk" %}
