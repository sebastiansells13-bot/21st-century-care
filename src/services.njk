---
layout: layouts/page.njk
title: Services
titleKey: nav.services
permalink: /services/
description: Housing, health, skills, and community support services available to Medicaid recipients through 21st Century Care in Southern New Mexico.
ogImage: /img/hero/services-hero.jpg
---
{% from "macros/bilingual.njk" import bilingual %}
<div class="hero--photo">
  <img class="hero__bg" src="/img/hero/services-hero.jpg" alt="" width="1600" height="1200">
  <div class="hero__content wrapper">
    <span class="hero__eyebrow" data-i18n="hero.whatWeOffer">What We Offer</span>
    <h1 data-i18n="nav.services">Services</h1>
    <p data-i18n="overview.ccssPss">
      Comprehensive Community Support Services (CCSS) and Peer Support Services (PSS)
      are available to Medicaid recipients. Services help clients develop skills and
      connect to resources related to independent and community living, learning,
      employment, socialization, and recreation.
    </p>
  </div>
  {# First category band uses tintClass(0), i.e. green — keep in sync. #}
  {% set waveTint = "green" %}
  {% include "components/hero-wave.njk" %}
</div>

{% for category, items in services.list | groupby("category") %}
<div class="category-section {{ loop.index0 | tintClass }}">
  <div class="wrapper">
    {#
      Category names are CMS data (a creatable select in .pages.yml), so
      their Spanish lives in i18n.json under "serviceCategory.<English name>"
      and is looked up here at build time. A category the client adds from
      the CMS with no matching entry just shows its English name in both
      languages rather than a raw key.
    #}
    {% set categoryEs = i18n["serviceCategory." + category].es if i18n["serviceCategory." + category] else "" %}
    {% if category %}{{ bilingual(category, categoryEs, tag="h2") }}{% endif %}
    <div class="services-grid">
      {% for service in items %}
      <div class="service-card">
        {% if service.icon %}
          <img src="{{ service.icon }}" alt="" class="service-card__icon">
        {% else %}
          <span class="service-card__badge">{{ service.title | serviceIcon }}</span>
        {% endif %}
        <h3>{{ bilingual(service.title, service.titleEs) }}</h3>
        {{ bilingual(service.description, service.descriptionEs, tag="p", isSafe=true) }}
      </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endfor %}

{% include "components/crisis-callout.njk" %}
