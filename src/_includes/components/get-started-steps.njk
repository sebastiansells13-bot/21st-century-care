<!--
  Generic 4-step intake outline, restated from the flyer's own description of
  how CCSS/PSS work (support staff -> assessment -> assigned support team ->
  service plan). Confirm the exact steps/order/timeline with the client
  before treating this as authoritative — see AGENTS.md's "Needs client
  review" list.
-->
<ol class="steps">
  <li class="steps__item">
    <span class="steps__number">1</span>
    <div>
      <h3 data-i18n="getStarted.step1.title">Reach out</h3>
      <p data-i18n="getStarted.step1.body">Call, email, or send a referral form — yours or a case manager's, family
        member's, or provider's on your behalf.</p>
    </div>
  </li>
  <li class="steps__item">
    <span class="steps__number">2</span>
    <div>
      <h3 data-i18n="getStarted.step2.title">Brief assessment</h3>
      <p data-i18n="getStarted.step2.body">A short conversation to understand your needs, goals, and Medicaid
        eligibility for CCSS or PSS.</p>
    </div>
  </li>
  <li class="steps__item">
    <span class="steps__number">3</span>
    <div>
      <h3 data-i18n="getStarted.step3.title">Get matched</h3>
      <p data-i18n="getStarted.step3.body">You're assigned a Community Support Worker or Peer Support Specialist
        who becomes your ongoing point of contact.</p>
    </div>
  </li>
  <li class="steps__item">
    <span class="steps__number">4</span>
    <div>
      <h3 data-i18n="getStarted.step4.title">Build your plan</h3>
      <p data-i18n="getStarted.step4.body">Together, you build a personalized service plan and start working
        toward your goals.</p>
    </div>
  </li>
</ol>
