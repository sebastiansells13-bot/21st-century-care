<!--
  Decorative bottom edge for .hero--photo (see components.scss) — softens
  the hard photo/content seam with a wave instead of a straight cut. The
  path fills with currentColor, set in components.scss (.hero__wave): white
  by default, or a section tint when the page sets `waveTint` ("green",
  "blue" or "warm") before including this, to match a tinted first section.
-->
<svg class="hero__wave{% if waveTint %} hero__wave--{{ waveTint }}{% endif %}" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
  <path fill="currentColor" d="M0,32 C240,80 480,0 720,24 C960,48 1200,88 1440,40 L1440,80 L0,80 Z"/>
</svg>
