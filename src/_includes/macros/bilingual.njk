{#
  Renders `en` alone when `es` is empty (the honest default — no Spanish
  version yet, so just show what's actually there). When `es` is set,
  renders both as sibling elements tagged data-i18n-lang="en"/"es" and lets
  src/_includes/js/i18n.js's language toggle show/hide the matching one.
  Used wherever a translated string needs to interpolate business.json data
  (e.g. business.name inside a heading) that the plain i18n.json dictionary
  can't hold, and for business.json fields themselves (tagline/taglineEs).

  `tag` picks the wrapping element (default "span"; pass "h1"/"p" etc. for a
  standalone block). `isSafe` marks `en`/`es` as already-safe HTML.
#}
{% macro bilingual(en, es, tag="span", isSafe=false) %}{% if es %}<{{ tag }} data-i18n-lang="en">{{ (en | safe) if isSafe else en }}</{{ tag }}><{{ tag }} data-i18n-lang="es" hidden>{{ (es | safe) if isSafe else es }}</{{ tag }}>{% else %}{{ (en | safe) if isSafe else en }}{% endif %}{% endmacro %}
