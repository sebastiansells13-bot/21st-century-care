<!doctype html>
<html lang="{{ metadata.language }}">
<head>
  {% set pageTitle %}{% if title %}{{ title }} · {% endif %}{{ business.name or metadata.title }}{% endset %}
  {% set pageDescription %}{{ description or business.tagline or metadata.description }}{% endset %}
  {% set pageImage %}{{ (ogImage or "/img/hero/organ-mountains-hero.jpg") | url }}{% endset %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ siteOrigin }}{{ page.url | url }}">
  <meta property="og:image" content="{{ siteOrigin }}{{ pageImage }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ siteOrigin }}{{ pageImage }}">
  <link rel="icon" href="/favicons/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicons/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&amp;display=swap">
  <link rel="stylesheet" href="{{ assetPaths.stylesheet }}">
  {% if collections %}<link rel="alternate" href="/feed.xml" type="application/atom+xml" title="{{ business.name }}">{% endif %}
</head>
<body>
  <a class="skip-link" href="#main-content" data-i18n="skip.toContent">Skip to content</a>
  {% include "components/header.njk" %}
  <main id="main-content">
    {{ content | safe }}
  </main>
  {% include "components/footer.njk" %}
  <script type="application/json" id="i18n-data">{{ i18n | dump | safe }}</script>
  <!--
    i18n-runtime.js has no dependencies of its own, so it loads first, then
    i18n.js (applies [data-i18n]/[data-i18n-lang] to the DOM). See
    AGENTS.md's "Spanish-language toggle" note before adding a new
    translated string.
  -->
  <script src="/js/i18n-runtime.js" defer></script>
  <script src="/js/i18n.js" defer></script>
  <script src="/js/nav.js" defer></script>
</body>
</html>
