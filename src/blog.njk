---
layout: layouts/page.njk
title: Blog
permalink: /blog/
---
<div class="hero">
  <div class="wrapper">
    <h1>Blog</h1>
  </div>
</div>
<div class="wrapper">
  <ul class="post-list">
    {% for post in collections.posts | reverse %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}</a><br>
      <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
    </li>
    {% endfor %}
  </ul>
</div>
