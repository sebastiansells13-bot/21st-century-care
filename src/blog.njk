---
layout: layouts/page.njk
title: Blog
permalink: /blog/
description: News and updates from 21st Century Care.
---
<div class="hero">
  <div class="wrapper">
    <h1 data-i18n="blog.heading">Blog</h1>
  </div>
</div>
<div class="wrapper">
  {% if collections.posts.length %}
  <ul class="post-list">
    {% for post in collections.posts | reverse %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}</a><br>
      <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="empty-state" data-i18n="blog.empty">No posts yet — check back soon.</p>
  {% endif %}
</div>
